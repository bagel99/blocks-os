var buf: [1024]_byte;

proc main(): _int
{   var i, n: _uint;
    var ctx: aescbc.State;

    bde = prt.open(prt.fde, 256);
    bde.setflush(true);

    for i from 0 to tests?len-1 do
    {   n = tests[i].len;
	print bde, "Test [d] len=[d]\n", i+1, n;
	ctx.Start(tests[i].key, tests[i].keysz, tests[i].iv);
	ctx.Encrypt(buf, tests[i].plain, n);
//    DumpBlock(buf, n);
	if buf[0:n] != tests[i].cipher[0:n] then
	{
	    print bde, "Encrypt failed\n";
	}
	ctx.Start(tests[i].key, tests[i].keysz, tests[i].iv);
	ctx.Decrypt(buf, tests[i].cipher, n);
//    DumpBlock(buf, n);
	if buf[0:n] != tests[i].plain[0:n] then
	{
	    print bde, "Decrypt failed\n";
	}
    }
    return 0;
}
