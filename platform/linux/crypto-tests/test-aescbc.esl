import prt;
var bde: fmt.pDesc;

package fmt
{
    proc hexncvt(buf: @_memory, n: _uint, a: @[]_byte): _uint
    {   var i: _uint = 0;
	var k: _uint = 0;
	while k < n do
	{   buf[i] =   hexuchr[a[k]>>4];
	    buf[i+1] = hexuchr[a[k]&0xF];
	    i += 2;
	    k += 1;
	}
	return i;
    }

    proc (bd: fmt.pDesc) hexnfmt(a: @[]_byte, spec: fmt.FmtSpec)
    {	var w, tw, sw: _uint;
	const MAXWIDTH = 64;
	var tmp: [MAXWIDTH]_byte;
	var buf: @_memory;
	sw = _min(spec.width, MAXWIDTH);
	w = hexncvt(tmp, sw/2, a);
	buf, tw, _ = bd.padding(w, RIGHT, spec);
	buf[0:w] = tmp[0:w];
    }
}

proc DumpBlock(data: @[]_byte, len: _uint)
{   var i: _uint;

    for i from 0 to len-1 do
    {	print bde, "[02X]", data[i];
	if i % 32 == 31 then print bde, "\n";
    }
    print bde, "\n";
}


import aescbc;

type Test:
{   keysz: aes.KeySize;
    len:   _uint16;
    key:   @[]_byte;
    iv:    @[]_byte;
    plain: @[]_byte;
    cipher:@[]_byte;
};

const tests: []Test =
{
  // FIPS SP800-38A Example F.2.1
  {
    .keysz = KEY128,
    .key = {
	0x2b,0x7e,0x15,0x16,0x28,0xae,0xd2,0xa6,0xab,0xf7,0x15,0x88,0x09,0xcf,0x4f,0x3c
