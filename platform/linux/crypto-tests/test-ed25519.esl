import prt;
var bde: fmt.pDesc;

package fmt
{
    proc hexncvt(buf: @_memory, n: _uint, a: @[]_byte): _uint
    {   var i: _uint = 0;
	var k: _uint = 0;
	while k < n do
	{   buf[i] =   hexuchr[a[k]>>4];
	    buf[i+1] = hexuchr[a[k]&0xF];
	    i += 2;
	    k += 1;
	}
	return i;
    }

    proc (bd: fmt.pDesc) hexnfmt(a: @[]_byte, spec: fmt.FmtSpec)
    {	var w, tw, sw: _uint;
	const MAXWIDTH = 64;
	var tmp: [MAXWIDTH]_byte;
	var buf: @_memory;
	sw = _min(spec.width, MAXWIDTH);
	w = hexncvt(tmp, sw/2, a);
	buf, tw, _ = bd.padding(w, RIGHT, spec);
	buf[0:w] = tmp[0:w];
    }
}

import ed25519;

alias ed25519.Key as Key;
proc Hex1(x: _byte): _byte
{
    if x
    is '0'..'9' then return x-'0';
    is 'A'..'F' then return x-'A'+10;
    is 'a'..'f' then return x-'a'+10;
    return 0;	// error
}

proc FromHex(x: @[]_byte, n: _uint, b: @[]_byte)
{   var i: _uint;

    if n == 0 then return;
    for i from 0 to n-1 do
    {   b[i] = (Hex1(x[2*i]) << 4) | (Hex1(x[2*i+1]));
    }
}

type TestS:
{
    pvtk: @[]_byte;	// private key
    pubk: @[]_byte;	// public key x
    msg:  @[]_byte;	// message
    len:  _uint;	// message length
    sign: @[]_byte;	// signature R,S
};

// Test cases from RFC 8032 section 7.1
const tests: []TestS =
{
  { // TEST 1
    .pvtk = "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60",
