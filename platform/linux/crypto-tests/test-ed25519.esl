    .pvtk = "c5aa8df43f9f837bedb7442f31dcb7b166d38535076f094b85ce3a2e0b4458f7",
    .pubk = "fc51cd8e6218a1a38da47ed00230f0580816ed13ba3303ac5deb911548908025",
    .msg  = "af82",
    .len  = 2,
    .sign = "6291d657deec24024827e69c3abe01a30ce548a284743a445e3680d7db5ac3ac"
	    "18ff9b538d16f290ae67f760984dc6594a7c15e9716ed28dc027beceea1ec40a"
  },
  { // RNS announce
    .pvtk = "55fd970087033817a6c0c56af45cc15bf2576d309dd243cb1b8db2b89785c805",
    .pubk = "BEC089F849A40BCFB60DD0B0AF18BDFE447030EAFC7E4D14643CB051C5FF3C19",
    .msg  = "14CB29CB444A2EA2E8DFC41942DDA2F4"
	    "2CA10F3127D9FE72C2100EA5ACB33DF4FC5C1A8A3D5C55D2A3451D3410F88F5F"
	    "BEC089F849A40BCFB60DD0B0AF18BDFE447030EAFC7E4D14643CB051C5FF3C19"
	    "8DE025DDDFE0AD9B791A"
	    "035541FAB3006AE6195B"
	    "5261646F6E",
    .len  = 105,
    .sign = "1F242FD84DFB1C85D0BAB490A7F9244731AEE2525C3236B063E8D2B0890C558A"
	    "6E02987D61AD5D524294244924EFDCD9DB07D2A735FAC6A62942968AF360BA09"
   },
   {
    .pvtk = "4b7a00961e8b23ac2b0f38ef57092975fea42921aa19fbf810c48a78961ff098",
