var buf: [1024]_byte;

proc main(): _int
{   var i: _uint;
    var pubk, pvtk, tstk, seed: Key;
    var asign, tsign: [64]_byte;
    var errcnt: _int = 0;

    bde = prt.open(prt.fde, 256);
    bde.setflush(true);

    for i from 0 to tests?len-1 do
    {
	print bde, "\nTest [d]\n\n", i+1;
	FromHex(tests[i].pvtk, Key?len, seed);
	FromHex(tests[i].pubk, Key?len, tstk);
//	print bde, "seed:\t[64%hexn]\n", seed;
	ed25519.GenKeyPair(pubk, pvtk, seed);
	print bde, "prvk:\t[64%hexn]\n", pvtk;
	print bde, "pubk:\t[64%hexn]\n", pubk;
	if pubk != tstk then
	{   print bde, "GenKeyPair failed\n";
	    print bde, "tstk:\t[64%hexn]\n", tstk;
	    errcnt += 1;
	}
	FromHex(tests[i].msg,  tests[i].len, buf);
	ed25519.Sign(asign, buf, tests[i].len, pubk, pvtk);
	print bde, "sign:\t[64%hexn]\n\t[64%hexn]\n",
		asign[0:32], asign[32:32];
	FromHex(tests[i].sign, 64, tsign);
	if asign != tsign then
	{   print bde, "Sign failed\n";
	    print bde, "tsign:\t[64%hexn]\n\t[64%hexn]\n",
		    tsign[0:32], tsign[32:32];
	    errcnt += 1;
	}
	if !ed25519.Verify(asign, buf, tests[i].len, pubk) then
	{   print bde, "Verify failed\n";
	    errcnt += 1;
	}
    }
    return errcnt;
}
